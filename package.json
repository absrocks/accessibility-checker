{
  "name": "accessibility-checker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local accessibility checker: scans pages with axe-core, tracks findings over time.",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\"",
    "export": "node --disable-warning=ExperimentalWarning src/export.js",
    "deploy": "sh scripts/deploy.sh"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "axe-core": "^4.14.0",
    "express": "^5.3.0",
    "playwright-core": "^1.65.0",
    "sql.js": "^1.16.0"
  }
}
